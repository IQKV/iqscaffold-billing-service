<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iqkv</groupId>
        <artifactId>boot-parent-pom</artifactId>
        <version>0.25.0-SNAPSHOT</version>
    </parent>

    <artifactId>iqscaffold-billing-service</artifactId>
    <packaging>jar</packaging>

    <name>IQ Scaffold Billing Service</name>
    <description>Billing and subscription management service</description>

    <properties>
        <spring-boot.run.jvmArguments>-Duser.timezone=UTC</spring-boot.run.jvmArguments>
        <checkstyle.skip>false</checkstyle.skip>
        <maven.gitcommitid.skip>false</maven.gitcommitid.skip>
        <jacoco.skip>false</jacoco.skip>
    </properties>

    <dependencies>
        <!-- Spring Boot starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <!-- OpenAPI documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Observability -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test-autoconfigure</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 Database for testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- Spring AMQP Test -->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Resilience4j for Circuit Breaker and Time Limiter -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
        </dependency>

        <!-- Stripe Java SDK -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
        </dependency>

        <!-- Hibernate Second Level Cache with Ehcache 3 -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-jcache</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ehcache</groupId>
            <artifactId>ehcache</artifactId>
            <classifier>jakarta</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Application entry point -->
                        <exclude>**/*Application.class</exclude>

                        <!-- Configuration classes -->
                        <exclude>**/*Config.class</exclude>
                        <exclude>**/*Config$*.class</exclude>
                        <exclude>**/*Configuration.class</exclude>
                        <exclude>**/*Configuration$*.class</exclude>
                        <exclude>**/*Properties.class</exclude>
                        <exclude>**/*Properties$*.class</exclude>

                        <!-- Billing service config package exclusion -->
                        <exclude>**/billingservice/config/*.class</exclude>

                        <!-- DTOs and Records -->
                        <exclude>**/dto/*.class</exclude>
                        <exclude>**/*Dto.class</exclude>
                        <exclude>**/*Dto$*.class</exclude>
                        <exclude>**/*Request.class</exclude>
                        <exclude>**/*Response.class</exclude>
                        <exclude>**/*Detail.class</exclude>
                        <exclude>**/*Data.class</exclude>

                        <!-- Constants -->
                        <exclude>**/*Constants.class</exclude>
                        <exclude>**/*Constants$*.class</exclude>

                        <!-- Enums -->
                        <exclude>**/*Status.class</exclude>

                        <!-- Exceptions -->
                        <exclude>**/*Exception.class</exclude>

                        <!-- REST Resources (Controllers) -->
                        <exclude>**/*RestResource.class</exclude>

                        <!-- Filters -->
                        <exclude>**/*Filter.class</exclude>

                        <!-- Health Indicators -->
                        <exclude>**/*HealthIndicator.class</exclude>

                        <!-- Metrics -->
                        <exclude>**/*Metrics.class</exclude>

                        <!-- Serializers/Deserializers -->
                        <exclude>**/*Serializer.class</exclude>
                        <exclude>**/*Deserializer.class</exclude>

                        <!-- Liquibase initializers -->
                        <exclude>**/*Initializer.class</exclude>
                        <exclude>**/*Runner.class</exclude>
                        <exclude>**/*DependencyConfigurer.class</exclude>

                        <!-- Loggers -->
                        <exclude>**/*Logger.class</exclude>

                        <!-- Event Listeners -->
                        <exclude>**/*Listener.class</exclude>
                        <exclude>**/*EventListener.class</exclude>

                        <!-- Messaging Events -->
                        <exclude>**/infrastructure/messaging/*Event.class</exclude>
                        <exclude>**/infrastructure/messaging/*Publisher.class</exclude>

                        <!-- Infrastructure Clients -->
                        <exclude>**/infrastructure/client/*Client.class</exclude>

                        <!-- Security Constants -->
                        <exclude>**/security/JwtClaimNames.class</exclude>

                        <!-- Admin Services (Merchant Onboarding) -->
                        <exclude>**/admin/MerchantOnboardingService.class</exclude>

                        <!-- Webhook handlers and services -->
                        <exclude>**/webhook/PayoutWebhookEventHandler.class</exclude>
                        <exclude>**/webhook/AccountWebhookEventHandler.class</exclude>
                        <exclude>**/webhook/UnifiedWebhookService.class</exclude>
                        <exclude>**/webhook/PaymentWebhookEventHandler.class</exclude>
                        <exclude>**/webhook/WebhookEvent.class</exclude>
                        <exclude>**/webhook/StripeWebhookService.class</exclude>
                        <exclude>**/webhook/InvoiceWebhookEventHandler.class</exclude>
                        <exclude>**/webhook/SubscriptionWebhookEventHandler.class</exclude>

                        <!-- Subscription events -->
                        <exclude>**/subscription/event/SubscriptionEventPublisher.class</exclude>
                        <exclude>**/subscription/event/SubscriptionEvent.class</exclude>
                        <exclude>**/subscription/event/SubscriptionEvent$*.class</exclude>

                        <!-- Shared services -->
                        <exclude>**/shared/PaymentGatewayProvider.class</exclude>
                        <exclude>**/shared/EmailService.class</exclude>
                        <exclude>**/shared/NotificationService.class</exclude>
                        <exclude>**/shared/MessageService.class</exclude>

                        <!-- Admin services -->
                        <exclude>**/admin/PaymentGatewayConfigService.class</exclude>

                        <!-- Security services -->
                        <exclude>**/security/UserContext.class</exclude>
                        <exclude>**/security/SecurityContextHelper.class</exclude>
                        <exclude>**/security/GatewayConfigEncryptionService.class</exclude>
                        <exclude>**/security/BillingAuthorizationService.class</exclude>

                        <!-- Infrastructure email -->
                        <exclude>**/infrastructure/email/EmailService.class</exclude>

                        <!-- Feature management (excluding tested classes) -->
                        <exclude>**/feature/FeatureType.class</exclude>
                        <exclude>**/feature/FeatureEntityGraphService.class</exclude>
                        <exclude>**/feature/FeatureEntityGraphService$*.class</exclude>
                        <exclude>**/feature/FeatureContext$Builder.class</exclude>
                        <exclude>**/feature/PlanFeature.class</exclude>
                        <exclude>**/feature/PlanFeature$*.class</exclude>
                        <exclude>**/feature/FeatureContext.class</exclude>
                        <exclude>**/feature/FeatureDefinition.class</exclude>
                        <exclude>**/feature/FeatureEnablementService.class</exclude>
                        <exclude>**/feature/FeatureResource.class</exclude>

                        <!-- Tenancy -->
                        <exclude>**/tenancy/TenantContext.class</exclude>
                        <exclude>**/tenancy/SchemaPerTenantConnectionProvider.class</exclude>
                        <exclude>**/tenancy/SchemaTenantIdentifierResolver.class</exclude>

                        <!-- Subscription entities and services -->
                        <exclude>**/subscription/SubscriptionInvoice.class</exclude>
                        <exclude>**/subscription/SubscriptionEntityGraphService.class</exclude>
                        <exclude>**/subscription/SubscriptionEntityGraphService$*.class</exclude>
                        <exclude>**/subscription/SubscriptionPlanServiceImpl.class</exclude>
                        <exclude>**/subscription/SubscriptionPlan.class</exclude>
                        <exclude>**/subscription/SubscriptionStateMachine.class</exclude>
                        <exclude>**/subscription/TenantSubscription.class</exclude>
                        <exclude>**/subscription/TenantSubscriptionAuditTrail.class</exclude>
                        <exclude>**/subscription/SubscriptionInterval.class</exclude>
                        <exclude>**/subscription/SubscriptionItem.class</exclude>
                        <exclude>**/subscription/SubscriptionServiceImpl.class</exclude>

                        <!-- Payout -->
                        <exclude>**/payout/Payout.class</exclude>
                        <exclude>**/payout/PayoutService.class</exclude>

                        <!-- Payment services and entities -->
                        <exclude>**/payment/RefundServiceImpl.class</exclude>
                        <exclude>**/payment/Payment.class</exclude>
                        <exclude>**/payment/StripePaymentProvider.class</exclude>
                        <exclude>**/payment/PaymentNotificationService.class</exclude>
                        <exclude>**/payment/PaymentNotificationService$*.class</exclude>
                        <exclude>**/payment/GatewayConfigurationService.class</exclude>
                        <exclude>**/payment/PaymentProviderFactory.class</exclude>
                        <exclude>**/payment/PaymentAuditTrailService.class</exclude>
                        <exclude>**/payment/PaymentProviderAdapter$*.class</exclude>
                        <exclude>**/payment/StripeCustomer.class</exclude>
                        <exclude>**/payment/PaymentServiceImpl.class</exclude>
                        <exclude>**/payment/PaymentStateMachine.class</exclude>
                        <exclude>**/payment/PaymentGatewayCustomer.class</exclude>

                        <!-- Infrastructure messaging -->
                        <exclude>**/infrastructure/messaging/MessagingService.class</exclude>

                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>coverage-check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.7</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.7</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.5</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <name>Central Portal Snapshots</name>
            <id>central-portal-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
