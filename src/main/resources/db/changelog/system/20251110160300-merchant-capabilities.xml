<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="20251110160300-merchant-capabilities" author="iqscaffold" context="public">
        <comment>Add charges_enabled and payouts_enabled capabilities to merchant_stripe_config table</comment>

        <addColumn tableName="merchant_stripe_config">
            <column name="charges_enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="payouts_enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="merchant_stripe_config" columnName="charges_enabled"/>
            <dropColumn tableName="merchant_stripe_config" columnName="payouts_enabled"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
